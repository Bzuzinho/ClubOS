APP_NAME="ClubOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Database - PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=spark_db
DB_USERNAME=spark_user
DB_PASSWORD=secret
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_PROTECT_DESTRUCTIVE_COMMANDS=true
DB_ALLOW_DESTRUCTIVE_COMMANDS=false
DB_DESTRUCTIVE_CONFIRMATION=

# Cache & Sessions - Redis (production)
CACHE_STORE=redis
CACHE_PREFIX=spark_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5

# Redis Configuration
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# Filesystem
FILESYSTEM_DISK=local

# Broadcasting
BROADCAST_CONNECTION=log

# Mail (configure for production)
MAIL_MAILER=log
MAIL_WEBHOOK_SECRET=
WEBSITE_SUBMISSIONS_RECIPIENT=beneditasportclubnatacao@gmail.com

# Communication providers (fail closed until explicitly configured)
SMS_ENABLED=false
SMS_PROVIDER=sms_http
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=ClubOS
SMS_WEBHOOK_SECRET=
PUSH_ENABLED=false
PUSH_PROVIDER=push_http
PUSH_API_URL=
PUSH_API_TOKEN=
PUSH_WEBHOOK_SECRET=
COMMUNICATION_WEBHOOK_MAX_AGE_SECONDS=300

# Fiscal - productive workflow is manual Wintouch until a real HTTP provider adapter exists
FISCAL_OPERATION_MODE=manual_wintouch
FISCAL_PROVIDER=wintouch

VITE_APP_NAME="${APP_NAME}"
